{
  "name": "Jobfit AI 통합 채용 데이터 수집 워크플로우",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 12
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "스케줄 (12시간마다)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [100, 250]
    },
    {
      "parameters": {},
      "id": "manual-trigger",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [100, 400]
    },
    {
      "parameters": {
        "jsCode": "const categories = ['software-dev','data','devops-sysadmin','artificial-intelligence'];\nreturn categories.map(cat => ({ json: { category: cat } }));"
      },
      "id": "remotive-category-list",
      "name": "remotive-category-list",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [320, 200]
    },
    {
      "parameters": {
        "url": "=https://remotive.com/api/remote-jobs?category={{$json.category}}&limit=50",
        "options": {}
      },
      "id": "remotive-api",
      "name": "remotive-api",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [540, 200]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.all()[0].json;\nconst jobs = (raw.jobs || []).map(j => ({ ...j, source: 'remotive' }));\nreturn [{ json: { jobs } }];"
      },
      "id": "remotive-transform",
      "name": "remotive-transform",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [760, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:5000/api/jobs",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.jobs }}",
        "options": {}
      },
      "id": "remotive-flask-save",
      "name": "remotive-flask-save",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [980, 200]
    },
    {
      "parameters": {
        "jsCode": "const r = $input.all()[0].json;\nconsole.log(`✅ Remotive: ${r.saved}개 저장, ${r.skipped}개 스킵`);\nreturn [{ json: r }];"
      },
      "id": "remotive-log",
      "name": "remotive-log",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1200, 200]
    },
    {
      "parameters": {
        "url": "https://api.adzuna.com/v1/api/jobs/gb/search/1?app_id=4eb4b091&app_key=5b2e1f49f8ba38ac3018857378000166&results_per_page=50&what=developer&content-type=application/json",
        "options": {}
      },
      "id": "adzuna-api",
      "name": "adzuna-api",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [320, 400]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.all()[0].json;\nconst jobs = (raw.results || []).map(j => ({ ...j, source: 'adzuna' }));\nreturn [{ json: { jobs } }];"
      },
      "id": "adzuna-transform",
      "name": "adzuna-transform",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [540, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:5000/api/jobs",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.jobs }}",
        "options": {}
      },
      "id": "adzuna-flask-save",
      "name": "adzuna-flask-save",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [760, 400]
    },
    {
      "parameters": {
        "jsCode": "const r = $input.all()[0].json;\nconsole.log(`✅ Adzuna: ${r.saved}개 저장, ${r.skipped}개 스킵`);\nreturn [{ json: r }];"
      },
      "id": "adzuna-log",
      "name": "adzuna-log",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [980, 400]
    }
  ],
